{
  "name": "wird-promo",
  "private": true,
  "version": "1.0.0",
  "description": "Motion-graphics promo video for Wird (Remotion).",
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts WirdPromo out/wird-promo.mp4 --codec=h264 --crf=16 --pixel-format=yuv420p --color-space=bt709",
    "still": "remotion still src/index.ts WirdPromo out/still.png",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@fontsource/amiri": "5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@remotion/cli": "4.0.532",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.532"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "typescript": "7.0.2"
  }
}
