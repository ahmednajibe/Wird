{
  "name": "learning-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "Personal, local-only learning tracker (Quran, Full Stack, AI, Animation).",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev:server": "tsx watch --no-warnings=ExperimentalWarning src/server/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --no-warnings=ExperimentalWarning dist/server/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "gen:quran": "tsx scripts/gen-quran-data.ts"
  },
  "dependencies": {
    "@hono/node-server": "1.19.17",
    "hono": "4.13.8",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "25.9.7",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
